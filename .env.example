# MongoDB Atlas connection used only by server-side code and maintenance scripts.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=drug_safety_signal_explorer

# Better Auth server configuration. Generate a high-entropy secret of at least
# 32 characters. Create admin accounts before adding their normalized email
# addresses to ADMIN_EMAILS; reserved admin emails cannot use public sign-up.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAILS=

# Reserved for later phases. Keep all secrets server-side.
OPENFDA_API_KEY=
MISTRAL_API_KEY=
