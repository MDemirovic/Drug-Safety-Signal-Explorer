# MongoDB Atlas connection used only by server-side code and maintenance scripts.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=drug_safety_signal_explorer

# Clerk authentication. The publishable key is safe for browser use; the secret
# key must remain server-side. Add verified admin email addresses as a
# comma-separated list.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_EMAILS=

# Optional openFDA key raises upstream request limits. The Mistral key is
# required for cached AI summaries. Keep both server-side; never prefix them
# with NEXT_PUBLIC_.
OPENFDA_API_KEY=
MISTRAL_API_KEY=
